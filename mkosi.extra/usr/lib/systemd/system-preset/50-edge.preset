enable tailscaled.service
enable edge-firstboot.service
enable k3s-agent.service
enable noded.service
enable edge-external-ip.timer
enable edge-node-annotate.service
enable systemd-oomd.service
enable systemd-networkd.service
enable systemd-timesyncd.service
disable systemd-sysupdate.timer
disable systemd-sysupdate-reboot.timer
disable systemd-resolved.service
