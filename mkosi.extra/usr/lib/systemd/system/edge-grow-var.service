[Unit]
Description=Grow the /var partition to the end of the disk
DefaultDependencies=no
After=systemd-udevd.service systemd-udev-trigger.service
Before=var.mount local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
# '-': a failed grow must not stop /var from mounting; the node still works with the original size.
ExecStart=-/usr/libexec/edge-grow-var
