[Unit]
Description=k3s agent
After=network-online.target tailscaled.service edge-firstboot.service
Wants=network-online.target
PartOf=tailscaled.service
ConditionPathExists=/var/lib/edge/k3s-config.yaml

[Service]
Environment=GOGC=40
Type=notify
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
# Phase 1.A: no pod (children inherit the bounding set) can load kernel modules or reboot the node
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_BOOT
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=/usr/libexec/edge-k3s-prep
ExecStart=/usr/local/bin/k3s agent --config /var/lib/edge/k3s-config.yaml

[Install]
WantedBy=multi-user.target
