#!/bin/sh
# Poll ip.me for this node's public IPv4. A change is accepted only if two reads agree and the address is globally
# routable. The value goes to /run/edge/external-ip and /var/lib/edge/external-ip (last known). If it changed, the k3s
# config is re-rendered and k3s-agent restarted once (at most every EDGE_IP_RESTART_COOLDOWN seconds).
set -eu
V=/var/lib/edge; R=/run/edge
install -d -m 0755 "$V" "$R"
norestart=0; [ "${1:-}" = "--no-restart" ] && norestart=1
url="${EDGE_IP_URL:-https://ip.me}"

valid() { # globally routable IPv4 only
  case "$1" in ''|*[!0-9.]*|.*|*.|*..*) return 1;; esac
  oldifs=$IFS; IFS=.
  # (POSIX sh has no local: valid() must not touch the caller's a, b, new)
  # shellcheck disable=SC2086 # splitting on dots is the point
  set -- $1
  IFS=$oldifs
  [ $# -eq 4 ] || return 1
  for o in "$@"; do [ "${#o}" -le 3 ] && [ "$o" -le 255 ] || return 1; done
  o1=$1; o2=$2; o3=$3
  if [ "$o1" -eq 0 ] || [ "$o1" -eq 10 ] || [ "$o1" -eq 127 ] || [ "$o1" -ge 224 ]; then return 1; fi
  [ "$o1" -eq 100 ] && [ "$o2" -ge 64 ] && [ "$o2" -le 127 ] && return 1        # CGNAT / Tailscale
  [ "$o1" -eq 169 ] && [ "$o2" -eq 254 ] && return 1
  [ "$o1" -eq 172 ] && [ "$o2" -ge 16 ] && [ "$o2" -le 31 ] && return 1
  [ "$o1" -eq 192 ] && [ "$o2" -eq 168 ] && return 1
  [ "$o1" -eq 192 ] && [ "$o2" -eq 0 ] && [ "$o3" -eq 0 ] && return 1
  [ "$o1" -eq 198 ] && { [ "$o2" -eq 18 ] || [ "$o2" -eq 19 ]; } && return 1
  return 0
}
read_ip() { curl -4 -fsS --max-time 8 "$url" 2>/dev/null | tr -d ' \r\n' || true; }

new=""
for attempt in 1 2 3; do
  a=$(read_ip); sleep "${EDGE_IP_GAP:-3}"; b=$(read_ip)
  if [ -n "$a" ] && [ "$a" = "$b" ] && valid "$a"; then new="$a"; break; fi
  echo "external-ip: attempt $attempt gave '$a' / '$b', not accepted" >&2
done

prev=$(cat "$V/external-ip" 2>/dev/null || true)
if [ -z "$new" ]; then
  [ -n "$prev" ] && { echo "$prev" > "$R/external-ip"; echo "external-ip: lookup failed, keeping $prev" >&2; exit 0; }
  echo "external-ip: lookup failed and no previous value" >&2; exit 1
fi
echo "$new" > "$R/external-ip"
[ "$new" = "$prev" ] && exit 0
echo "$new" > "$V/external-ip"
echo "external-ip: ${prev:-none} -> $new"
[ "$norestart" = 1 ] && exit 0
/usr/libexec/edge-render-k3s
if systemctl is-active --quiet k3s-agent.service; then
  last=$(stat -c %Y "$R/k3s-restarted" 2>/dev/null || echo 0)
  if [ $(( $(date +%s) - last )) -ge "${EDGE_IP_RESTART_COOLDOWN:-3600}" ]; then
    : > "$R/k3s-restarted"; systemctl restart k3s-agent.service
  else
    echo "external-ip: changed again within the cooldown, will apply on the next run" >&2
  fi
fi
