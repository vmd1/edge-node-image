#!/bin/bash
# Trim the kernel module tree to what an edge node (a VM running k3s + tailscale) can use. Nothing here is loaded at boot on
# the nodes (wifi, sound, GPU, USB, HID, media, exotic filesystems); removing the files also stops udev auto-loading them, and
# shrinks the root partition and the A/B download. depmod is re-run so modules.dep matches.
# Modules the trial node actually loaded (131 on zeus-01) are checked by scripts/check-image.sh.
set -euo pipefail
[ "${1:-}" = finalize ] || [ -n "${BUILDROOT:-}" ] || exit 0
cd "$BUILDROOT/usr/lib/modules"
for kdir in */; do
  kdir=${kdir%/}; k="$kdir/kernel"
  [ -d "$k" ] || continue
  before=$(du -sm "$k" | cut -f1)
  rm -rf "$k/sound" "$k/arch/x86/kvm"
  for d in media gpu video infiniband iio hid usb input comedi staging mtd bluetooth nfc firewire thunderbolt pcmcia isdn \
           hwmon leds regulator mmc memstick gnss w1 pinctrl i2c/busses iommu mfd phy rtc ptp pps misc/eeprom accessibility \
           parport pnp dca extcon fpga hv uio gpio spi spmi mailbox soundwire vfio; do
    rm -rf "$k/drivers/$d"
  done
  for d in wireless bluetooth can nfc 6lowpan ieee802154 appletalk x25 ax25 rds tipc sctp dccp atm mac80211 mac802154 wimax \
           openvswitch batman-adv smc l2tp hsr nsh lapb phonet caif rfkill ceph; do
    rm -rf "$k/net/$d"
  done
  rm -rf "$k/drivers/net/wireless" "$k/drivers/net/can" "$k/drivers/net/wan" "$k/drivers/net/usb" "$k/drivers/net/hyperv" \
         "$k/drivers/net/phy" "$k/drivers/net/mdio" "$k/drivers/net/ieee802154" "$k/drivers/net/arcnet" "$k/drivers/net/fddi"
  if [ -d "$k/drivers/net/ethernet" ]; then
    find "$k/drivers/net/ethernet" -mindepth 1 -maxdepth 1 ! -name intel ! -name amazon ! -name realtek ! -name broadcom \
      -exec rm -rf {} +
  fi
  if [ -d "$k/fs" ]; then
    find "$k/fs" -mindepth 1 -maxdepth 1 \
      ! -name 'ext4' ! -name 'jbd2' ! -name 'mbcache.ko*' ! -name 'fat' ! -name 'overlayfs' ! -name 'fuse' ! -name 'squashfs' \
      ! -name 'erofs' ! -name 'nfs' ! -name 'nfs_common' ! -name 'lockd' ! -name 'nls' ! -name 'netfs' ! -name 'fscache' \
      ! -name 'efivarfs' ! -name 'configfs' ! -name 'pstore' ! -name 'autofs' ! -name 'exportfs' ! -name 'quota' \
      ! -name 'binfmt_misc.ko*' ! -name 'cachefiles' ! -name 'nfsd' \
      -exec rm -rf {} +
  fi
  mkosi-chroot depmod -a "$kdir"
  echo "modules $kdir: ${before}M -> $(du -sm "$k" | cut -f1)M, $(find "$k" -name '*.ko*' | wc -l) files"
done

# ---------------------------------------------------------------------------------------------------------------------------
# Phase A hardening: take away everything a process could be made to run that the node does not need. The root is read-only and
# there is no login path (locked root, no SSH, no console login on the release build), so the risk is a process being made to
# run a binary, not someone logging in. The debug and trial profiles keep their shell and tools.
cd "$BUILDROOT"
debug=0
case " ${PROFILES:-} " in *" debug "*|*" trial "*) debug=1;; esac

# Package list for auditing, written before dpkg is removed (the SBOM in Phase G builds on it).
mkdir -p usr/lib/edge
mkosi-chroot dpkg-query -W -f '${Package} ${Version} ${Architecture}\n' > usr/lib/edge/packages.txt

# No setuid or setgid binary: su, mount, umount, unix_chkpwd, the polkit and dbus helpers and the rest are not needed by any unit.
find . -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod ug-s {} +

if [ "$debug" = 0 ]; then
  # Nothing installs packages on a read-only root.
  rm -rf usr/bin/dpkg usr/bin/dpkg-* usr/bin/apt usr/bin/apt-* usr/lib/apt usr/lib/dpkg etc/apt etc/dpkg \
         usr/share/dpkg usr/share/perl* usr/lib/*-linux-gnu/perl* usr/lib/*-linux-gnu/perl-base usr/bin/perl* usr/bin/pod* \
         usr/bin/bash usr/bin/rbash usr/bin/bashbug
  rm -f bin/bash bin/rbash
  # keep the dpkg status file for the audit trail, but nothing can read or write it
  # sh is dash; every edge script is POSIX sh
  [ "$(readlink usr/bin/sh)" = dash ] || ln -sf dash usr/bin/sh
fi

# Self-check: fail the build if any of this did not take effect.
n=$(find . -xdev -type f \( -perm -4000 -o -perm -2000 \) | wc -l)
[ "$n" = 0 ] || { echo "finalize: $n setuid/setgid files remain" >&2; find . -xdev -type f \( -perm -4000 -o -perm -2000 \) >&2; exit 1; }
if [ "$debug" = 0 ]; then
  for b in usr/bin/dpkg usr/bin/apt usr/bin/perl usr/bin/bash usr/bin/rbash; do
    [ ! -e "$b" ] || { echo "finalize: $b is still in the image" >&2; exit 1; }
  done
  # every shell script shipped by us must run under dash
  for f in usr/libexec/edge-* usr/lib/edge/health.d/*; do
    [ -f "$f" ] || continue
    case "$(head -1 "$f")" in "#!/bin/sh"|"#!/usr/bin/env sh") ;; *) echo "finalize: $f does not use /bin/sh" >&2; exit 1;; esac
  done
fi
# the kernel command line in mkosi.conf relies on these; do not build an image where they would be silently ignored
cfg=$(ls boot/config-* usr/lib/modules/*/config 2>/dev/null | head -1 || true)
if [ -n "$cfg" ]; then
  for opt in CONFIG_SECURITY_LOCKDOWN_LSM=y CONFIG_MODULE_SIG=y CONFIG_STRICT_DEVMEM=y CONFIG_SLAB_MERGE_DEFAULT; do
    grep -q "^${opt%%=*}" "$cfg" && echo "kernel config: $(grep "^${opt%%=*}" "$cfg")" || echo "kernel config: ${opt%%=*} not set" >&2
  done
  for opt in CONFIG_SECURITY_LOCKDOWN_LSM=y CONFIG_MODULE_SIG=y CONFIG_STRICT_DEVMEM=y; do
    grep -q "^$opt" "$cfg" || { echo "finalize: kernel config lacks $opt" >&2; exit 1; }
  done
else
  echo "finalize: no kernel config found to check lockdown support" >&2
fi
{
  echo "files: $(find . -xdev | wc -l)"
  echo "setuid/setgid: $n"
  echo "debug-profile: $debug"
} > usr/lib/edge/hardening-report.txt
cat usr/lib/edge/hardening-report.txt
